<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>3f6b2c1e-8d4a-4b7e-9c2f-5a1d7e9b4c60</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Gaffuri Piastrelle SA</ProviderName>
  <DefaultLocale>it-IT</DefaultLocale>
  <DisplayName DefaultValue="Salva in Progetti"/>
  <Description DefaultValue="Salva allegati e mail nelle cartelle progetto di SharePoint (sito Progetti)."/>
  <IconUrl DefaultValue="https://gaffuri-1914.github.io/salva-in-progetti/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://gaffuri-1914.github.io/salva-in-progetti/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://github.com/Gaffuri-1914/salva-in-progetti"/>
  <AppDomains>
    <AppDomain>https://gaffuri-1914.github.io</AppDomain>
    <AppDomain>https://login.microsoftonline.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.8"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://gaffuri-1914.github.io/salva-in-progetti/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.8">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="sipGroup">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="sipButton">
                  <Label resid="ButtonLabel"/>
                  <Supertip>
                    <Title resid="ButtonLabel"/>
                    <Description resid="ButtonDesc"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16"/>
                    <bt:Image size="32" resid="Icon32"/>
                    <bt:Image size="80" resid="Icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="TaskpaneUrl"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon16" DefaultValue="https://gaffuri-1914.github.io/salva-in-progetti/assets/icon-16.png"/>
        <bt:Image id="Icon32" DefaultValue="https://gaffuri-1914.github.io/salva-in-progetti/assets/icon-32.png"/>
        <bt:Image id="Icon80" DefaultValue="https://gaffuri-1914.github.io/salva-in-progetti/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="TaskpaneUrl" DefaultValue="https://gaffuri-1914.github.io/salva-in-progetti/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Gaffuri"/>
        <bt:String id="ButtonLabel" DefaultValue="Salva in Progetti"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="ButtonDesc" DefaultValue="Salva gli allegati (e facoltativamente la mail) in una cartella progetto su SharePoint."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
